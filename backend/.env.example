TYPESAFE_API_KEY=
# Optional local-demo controls. Restart the API after changing them.
DENIED_AD_THRESHOLD=0.70
DENIED_SAFETY_THRESHOLD=0.80

# Optional Tiger Data removal history. Leave PGHOST blank to run without storage.
# Copy these values from your Tiger service; its port may differ from 5432.
PGHOST=
PGPORT=5432
PGDATABASE=tsdb
PGUSER=tsdbadmin
PGPASSWORD=
PGSSLMODE=require
# Generate a private token of at least 32 characters; never put it in the extension.
BACKEND_API_TOKEN=
DENIED_RECORD_REMOVALS=1
DENIED_DB_SCHEMA=denied
# URL-only configurations may use TIGER_DATABASE_URL or TIMESCALE_SERVICE_URL.
# Native PG_* settings take precedence when PGHOST is populated.
