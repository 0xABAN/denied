{
  "name": "denied",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "test:api": "cd src/backend && uv run --env-file .env python -m unittest discover -s tests -v",
    "test:extension": "bun src/extension/tests/extension.smoke.ts",
    "test:video": "bun src/extension/tests/video.browser.ts && bun src/extension/tests/video.real.ts",
    "test:adapters": "bun src/extension/tests/adapters.browser.ts && bun src/extension/tests/adapters.real.ts",
    "observe:adapters": "bun src/extension/tests/adapters.live.ts",
    "test:telemetry": "uv run --project src/backend --env-file src/backend/.env bun src/extension/tests/telemetry.smoke.ts",
    "test:live": "bun src/extension/tests/live.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/chrome": "^0.1.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0"
  }
}
